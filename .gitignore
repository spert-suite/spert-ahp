# TypeScript build output (tsc -b artifacts)
tsconfig.tsbuildinfo
src/**/*.js
src/**/*.js.map
vite.config.js
vite.config.js.map

# Vite drops these at the project root when it bundles a TypeScript config, and
# leaves them behind if the process is killed. They sit beside vite.config.ts
# with a .mjs extension, which src/__tests__/copyright-headers.test.ts scopes as
# a root config file — an abandoned one turns `npm test` red for a reason the
# failure message cannot explain.
vite.config.*.timestamp-*
vitest.config.*.timestamp-*

# Merged firestore rules — local-only artifact for Firebase Console paste
firestore.rules.merged

# Audit baseline for the dependency-upgrade campaign (local-only, not committed)
/.audit-baseline.json
